"use client";

import { useState } from "react";
import { ReactReader } from "react-reader";
import { useAppStore } from "@/lib/store";
import { Loader2, Sparkles, X } from "lucide-react";
import { DictionaryModal } from "./DictionaryModal";
import { SimpleDictionaryModal } from "./SimpleDictionaryModal";
import { DictionaryResult } from "@/types";
import { lookupLocal } from "@/lib/local-dictionary";
import { motion, AnimatePresence } from "framer-motion";

interface EpubReaderProps {
  url: string | ArrayBuffer;
  title?: string;
  initialLocation?: string | number;
  onLocationChange?: (loc: string | number) => void;
}

export function EpubReader({ url, title, initialLocation, onLocationChange }: EpubReaderProps) {
  const [location, setLocation] = useState<string | number>(initialLocation || 0);
  const [rendition, setRendition] = useState<any>(null);
  
  // 查词相关状态
  const [selectedText, setSelectedText] = useState<string | null>(null);
  const [isConfirmSheetOpen, setIsConfirmSheetOpen] = useState(false);
  
  const [dictionaryResult, setDictionaryResult] = useState<DictionaryResult | null>(null);
  const [isAnalyzing, setIsAnalyzing] = useState(false);
  const [isSheetOpen, setIsSheetOpen] = useState(false);

  const addVocabulary = useAppStore((state) => state.addVocabulary);

  const onLocationChanged = (loc: string | number) => {
    setLocation(loc);
    if (onLocationChange) onLocationChange(loc);
  };

  // --- 核心修复：直接在电子书原图上监听点击 ---
  const handleRendition = (rendition: any) => {
    setRendition(rendition);

    // 1. PC端/鼠标选词逻辑
    rendition.on('selected', (cfiRange: string, contents: any) => {
      // 兼容处理：有些版本的 epub.js getRange 返回 Promise，有些返回 Range 对象
      const rangeOrPromise = rendition.getRange(cfiRange);
      
      Promise.resolve(rangeOrPromise).then((range: Range) => {
        if (!range) return;
        const text = range.toString().trim();
        if (text) {
          // 变动：不直接查词，而是弹出确认栏
          setSelectedText(text);
          setIsConfirmSheetOpen(true);
          // contents.window.getSelection().removeAllRanges(); // 暂时保留高亮，等待用户确认
        }
      });
    });

    // 2. 移动端手指点击逻辑 (修复手机点不动的问题)
    rendition.hooks.content.register((contents: any) => {
      const doc = contents.document;
      const body = doc.body;

      body.addEventListener('touchend', (e: any) => {
        // 只有单指点击才算查词，双指算缩放/翻页
        if (e.changedTouches.length !== 1) return;
        
        const touch = e.changedTouches[0];
        // 获取手指点击位置的单词
        // @ts-ignore
        const range = doc.caretRangeFromPoint ? doc.caretRangeFromPoint(touch.clientX, touch.clientY) : null;

        if (range && range.startContainer.nodeType === Node.TEXT_NODE) {
           // 延迟 150ms 执行，为了区分你是“想翻页”还是“想查词”
           setTimeout(() => {
              try {
                // 自动扩展选中整个单词
                range.expand('word'); 
                const word = range.toString().trim();
                // 确保点到的是字母，不是空白或标点
                if (word && /^[a-zA-Z\u00C0-\u00FF]+$/.test(word)) {
                   // 变动：移动端点击单词通常期望直接查词，但为了统一体验，也可以先确认
                   // 不过点击单词（而非框选）通常意图很明确，ImmersiveReader里点击单词也是直接查
                   // 所以这里保持直接查词，或者也改为确认？
                   // 用户说“还没框选完”，主要针对的是框选操作。点击单词是瞬时的。
                   // 让我们保持点击单词直接查词，框选才需要确认。
                   handleLookup(word);
                }
              } catch (err) {
                console.warn("Touch expand failed", err);
              }
           }, 150);
        }
      });
    });
  };

  // 确认查词
  const handleConfirmLookup = () => {
    if (selectedText) {
      handleLookup(selectedText);
      // 关键修复：关闭确认窗口时，需要完全重置状态
      setIsConfirmSheetOpen(false);
      setSelectedText(null); 
    }
  };

  // 查词功能函数
  const handleLookup = async (text: string) => {
    const cleanWord = text.trim();
    if (!cleanWord) return;

    setIsSheetOpen(true); // 呼出底部抽屉
    setDictionaryResult(null);
    setIsAnalyzing(true);



    // A. 优先查本地 (秒开)
    const localRes = lookupLocal(cleanWord);
    if (localRes) {
      setDictionaryResult({
        word: localRes.text,
        phonetic: localRes.phonetic,
        definition: localRes.definition,
        tags: localRes.tags,
        example: localRes.example,
        exampleTranslation: localRes.translation
      });
      setIsAnalyzing(false);
      return;
    }

    // B. 本地没有，查 AI (兜底)
    try {
      const res = await fetch("/api/analyze-selection", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ selection: cleanWord, type: "word" })
      });
      const data = await res.json();
      if (!data.error) {
        setDictionaryResult(data);
      }
    } catch (e) {
      console.error(e);
    } finally {
      setIsAnalyzing(false);
    }
  };

  return (
    <div className="relative w-full h-[calc(100vh-64px)] bg-white dark:bg-slate-900 overflow-hidden">
      {/* 电子书渲染器 */}
      <ReactReader
        url={url}
        title={title}
        location={location}
        locationChanged={onLocationChanged}
        getRendition={handleRendition}
        epubOptions={{
           allowPopups: true, 
           allowScriptedContent: true,
        }}
        loadingView={
          <div className="flex items-center justify-center h-full">
            <Loader2 className="w-8 h-8 animate-spin text-indigo-600" />
          </div>
        }
      />

      {/* 底部查词抽屉 - 电子书专用简化版 */}
      <SimpleDictionaryModal
        result={dictionaryResult}
        isLoading={isAnalyzing}
        onClose={() => setIsSheetOpen(false)}
        onAddToNotebook={(word) => {
          addVocabulary({
             id: Date.now().toString(),
             word: word.word,
             definition: word.definition,
             exampleTranslation: word.exampleTranslation,
             phonetic: word.phonetic,
             createdAt: new Date().toISOString(),
             reviewCount: 0,
             correctCount: 0
          });
          setIsSheetOpen(false);
        }}
      />

      {/* 确认分析工具栏 (模仿 ImmersiveReader) */}
      <AnimatePresence>
        {isConfirmSheetOpen && selectedText && (
          <motion.div
            initial={{ y: "100%" }}
            animate={{ y: 0 }}
            exit={{ y: "100%" }}
            transition={{ type: "spring", damping: 25, stiffness: 200 }}
            drag="y"
            dragConstraints={{ top: 0 }}
            dragElastic={0.2}
            onDragEnd={(e, info) => {
              if (info.offset.y > 100) {
                setIsConfirmSheetOpen(false);
                setSelectedText(null); // 拖拽关闭时也需要重置选词
              }
            }}
            className="fixed bottom-[60px] md:bottom-0 left-0 right-0 bg-white dark:bg-slate-900 shadow-[0_-4px_20px_rgba(0,0,0,0.1)] rounded-t-2xl z-40 border-t border-slate-100 dark:border-slate-800 max-h-[80vh] flex flex-col"
          >
            <div className="w-full flex justify-center pt-3 pb-1 cursor-grab active:cursor-grabbing" onClick={() => { setIsConfirmSheetOpen(false); setSelectedText(null); }}>
               <div className="w-12 h-1.5 bg-slate-200 dark:bg-slate-700 rounded-full" />
            </div>

            <div className="p-4 pb-8 md:max-w-4xl md:mx-auto w-full">
              <div className="flex items-start justify-between mb-4">
                 <div className="flex-1 pr-4">
                    <p className="text-sm text-slate-500 dark:text-slate-400 line-clamp-2 italic border-l-2 border-slate-200 dark:border-slate-700 pl-3">
                       "{selectedText}"
                    </p>
                 </div>
                 <button 
                   onClick={() => { setIsConfirmSheetOpen(false); setSelectedText(null); }}
                   className="p-1.5 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-full text-slate-400"
                 >
                   <X size={20} />
                 </button>
              </div>

              <button
                onClick={handleConfirmLookup}
                className="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-medium flex items-center justify-center gap-2 transition-colors shadow-sm"
              >
                <Sparkles size={18} />
                Analyze This
              </button>
            </div>
          </motion.div>
        )}
      </AnimatePresence>
    </div>
  );
}
