import { openDB } from 'idb';

const DB_NAME = 'ai-hub-library';
const STORE_NAME = 'books';
const FILE_STORE = 'book_files'; // 把文件和元数据分开存，这样更稳

export interface Book {
  id: string;
  title: string;
  author?: string;
  cover?: string;
  createdAt: number;
  progress?: number;
}

// 初始化数据库
export const initDB = async () => {
  return openDB(DB_NAME, 3, { // 升级到版本 3
    upgrade(db, oldVersion) {
      // 创建存储书籍信息的仓库
      if (!db.objectStoreNames.contains(STORE_NAME)) {
        db.createObjectStore(STORE_NAME, { keyPath: 'id' });
      }
      // 创建专门存储大文件 (Blob) 的仓库
      if (!db.objectStoreNames.contains(FILE_STORE)) {
        db.createObjectStore(FILE_STORE);
      }
    },
  });
};

// 保存书籍信息
export const saveBook = async (book: Book) => {
  const db = await initDB();
  await db.put(STORE_NAME, book);
};

// 获取所有书籍
export const getAllBooks = async (): Promise<Book[]> => {
  const db = await initDB();
  return db.getAll(STORE_NAME);
};

// 删除书籍
export const deleteBook = async (id: string) => {
  const db = await initDB();
  await db.delete(STORE_NAME, id);
  await db.delete(FILE_STORE, id);
};

// 保存书籍文件
export const saveBookFile = async (id: string, file: Blob) => {
  const db = await initDB();
  await db.put(FILE_STORE, file, id);
};

// 获取书籍文件
export const getBookFile = async (id: string): Promise<Blob | undefined> => {
  const db = await initDB();
  return db.get(FILE_STORE, id);
};
</file>

