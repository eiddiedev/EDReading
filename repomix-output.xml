  const handleAnalyze = async () => {
    setIsLoading(true);
    setResult(null);
    try {
      const response = await fetch("/api/analyze-selection", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          selection: text,
          type: "sentence"
        })
