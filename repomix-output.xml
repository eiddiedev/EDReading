"use client";

import { useState, useEffect, useRef } from "react";
import { useRouter } from "next/navigation";
import { useAppStore } from "@/lib/store";
import { supabase } from "@/lib/supabase";
import { ArticleCard } from "@/components/ArticleCard";
import { PasteToReadModal } from "@/components/PasteToReadModal";
import { ConfirmModal } from "@/components/ConfirmModal";
import { TopicSelectionModal, IELTS_TOPICS } from "@/components/TopicSelectionModal";
import { Plus, Sparkles, Loader2 } from "lucide-react";
import { Article } from "@/types";
import { analyzeArticleWithAI } from "@/app/actions";
import { toast } from "sonner";
import { motion } from "framer-motion"; // 修正了这里的引号

export default function LibraryPage() {
  const router = useRouter();
  const articles = useAppStore((state) => state.articles);
  const setArticles = useAppStore((state) => state.setArticles);
  const addArticle = useAppStore((state) => state.addArticle);
  const removeArticle = useAppStore((state) => state.removeArticle);
  const markAsRead = useAppStore((state) => state.markAsRead);
  const toggleReadStatus = useAppStore((state) => state.toggleReadStatus);
  
  const [isModalOpen, setIsModalOpen] = useState(false);
  const [isTopicModalOpen, setIsTopicModalOpen] = useState(false);
  const [deleteId, setDeleteId] = useState<string | null>(null);
  const [isMounted, setIsMounted] = useState(false);
  const [isGenerating, setIsGenerating] = useState(false);
  
  const [lastTopicId, setLastTopicId] = useState<string | null>(null);
  const hasCheckedDaily = useRef(false);

  useEffect(() => {
    setIsMounted(true);
    
    const fetchArticles = async (userId: string) => {
      const { data, error } = await supabase
        .from('articles')
        .select('*')
        .eq('user_id', userId)
        .order('created_at', { ascending: false });
        
      if (!error && data) {
        const mapped: Article[] = data.map((d: any) => ({
          id: d.id,
          title: d.title,
          title_zh: d.title_zh, 
          original_title: d.original_title,
          content: d.content,
          topic: d.topic,
          difficulty: d.difficulty || d.level || 'IELTS', 
          wordCount: d.word_count,
          createdAt: d.created_at,
          isRead: d.is_read,
          tags: d.tags || [],
        }));
        setArticles(mapped);
      }
    };

    const checkUser = async () => {
      const { data: { session } } = await supabase.auth.getSession();
      if (session?.user) {
        fetchArticles(session.user.id);
      } else {
        setArticles([]); 
      }
    };

    checkUser();

    const { data: { subscription } } = supabase.auth.onAuthStateChange((_event, session) => {
       if (session?.user) {
         fetchArticles(session.user.id);
       } else {
         setArticles([]); 
       }
    });

    return () => subscription.unsubscribe();
  }, [setArticles]);

  const handleGenerate = async (
    topicPrompt?: string, 
    level: string = 'IELTS', 
    isAuto: boolean = false, 
    count: number = 1
  ) => {
    if (isGenerating) return; 
    setIsGenerating(true);
    
    const total = count;
    let successCount = 0;
    const toastId = isAuto ? undefined : toast.loading(`AI 正在生成文章...`);

    const generateOne = async (index: number) => {
      try {
        const { data: { session } } = await supabase.auth.getSession();
        const userId = session?.user?.id;

        const res = await fetch("/api/generate-ielts", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ 
            topicPrompt, 
            level, 
            userId 
          }),
        });
        
        if (!res.ok) throw new Error("API Error");
        const data = await res.json();
        
        const newArticle: Article = {
          id: crypto.randomUUID ? crypto.randomUUID() : Date.now().toString(),
          title: data.title,
          title_zh: data.title_zh,
          original_title: data.title, 
          content: data.content,
          difficulty: data.difficulty || data.level || level, 
          wordCount: data.content.split(/\s+/).length,
          createdAt: new Date().toISOString(),
          topic: data.topic,
          tags: data.tags || [],
          isRead: false
        };
        
        await addArticle(newArticle);
        successCount++;
      } catch (error) {
        console.error(error);
      }
    };

    const promises = Array.from({ length: total }).map((_, i) => generateOne(i));
    await Promise.all(promises);

    setIsGenerating(false);
    if (!isAuto && toastId) {
      if (successCount > 0) toast.success(`生成成功`, { id: toastId });
      else toast.error("生成失败", { id: toastId });
    }
  };

  const confirmDelete = () => {
    if (deleteId) { removeArticle(deleteId); setDeleteId(null); toast.success("已删除"); }
  };

  if (!isMounted) return null;

  return (
    <main className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div className="flex items-center justify-between mb-8">
        <h1 className="text-3xl font-bold">文库</h1>
        <div className="flex gap-3">
          <button onClick={() => setIsTopicModalOpen(true)} className="flex items-center gap-2 px-4 py-2 bg-indigo-600 text-white rounded-lg">
            <Sparkles className="w-5 h-5" /> AI 生成
          </button>
          <button onClick={() => setIsModalOpen(true)} className="flex items-center gap-2 px-4 py-2 bg-slate-200 rounded-lg">
            <Plus className="w-5 h-5" /> 导入
          </button>
        </div>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {articles.map((article) => (
          <ArticleCard 
            key={article.id} 
            article={article} 
            onDelete={(id) => setDeleteId(id)}
            onRead={(id) => markAsRead(id)}
            onToggleRead={(id) => toggleReadStatus(id)}
          />
        ))}
      </div>

      <TopicSelectionModal
        isOpen={isTopicModalOpen}
        onClose={() => setIsTopicModalOpen(false)}
        onSelect={(p, id, l, c) => handleGenerate(p, l, false, c)}
        isGenerating={isGenerating}
      />
      <PasteToReadModal 
        isOpen={isModalOpen} 
        onClose={() => setIsModalOpen(false)} 
      />
      <ConfirmModal
        isOpen={!!deleteId}
        onClose={() => setDeleteId(null)}
        onConfirm={confirmDelete}
        title="删除确认"
        message="确定要删除吗？"
      />
    </main>
  );
}
</file>

<file path="app/(dashboard)/reader/[id]/page.tsx">
"use client";

import { useEffect, useState } from "react";
import { useParams, useRouter } from "next/navigation";
import { useAppStore } from "@/lib/store";
import { ImmersiveReader } from "@/components/ImmersiveReader";
import { EpubReader } from "@/components/EpubReader";
import { ArrowLeft } from "lucide-react";
import Link from "next/link";
import { Article } from "@/types";
import { getBookFile } from "@/lib/book-storage";

export default function ReaderPage() {
  const params = useParams();
  const router = useRouter();
  const rawId = params?.id as string;
  const articleId = rawId ? decodeURIComponent(rawId) : "";
  const articles = useAppStore((state) => state.articles);
  const [article, setArticle] = useState<Article | null>(null);
  const [bookUrl, setBookUrl] = useState<string | null>(null);
  const [bookMetadata, setBookMetadata] = useState<any>(null);
  const [isLoading, setIsLoading] = useState(true);

  // 滑动返回相关状态
  const [touchStart, setTouchStart] = useState<{ x: number, y: number } | null>(null);
  const [touchEnd, setTouchEnd] = useState<{ x: number, y: number } | null>(null);
  const minSwipeDistance = 120; // 增加触发阈值，从100增加到120

  useEffect(() => {
    if (!articleId) {
      setIsLoading(false);
      return;
    }

    // 1. Try finding in Articles Store
    const foundArticle = articles.find((a) => a.id === articleId);
    if (foundArticle) {
      setArticle(foundArticle);
      setIsLoading(false);
      return;
    }

    // 2. Try finding in Books (LocalStorage + IndexedDB)
    const loadBook = async () => {
      try {
        const storedBooks = localStorage.getItem('my_library');
        if (storedBooks) {
          const books = JSON.parse(storedBooks);
          const foundBook = books.find((b: any) => b.id === articleId);
          if (foundBook) {
            setBookMetadata(foundBook);
            const blob = await getBookFile(articleId);
            if (blob) {
              if (blob.size === 0) {
                 console.error("❌ Book file is empty (0 bytes)");
              } else {
                 // Force MIME type for safety
                 const safeBlob = new Blob([blob], { type: "application/epub+zip" });
                 const url = URL.createObjectURL(safeBlob);
                 setBookUrl(url);
              }
            }
            setIsLoading(false);
            return;
          }
        }
      } catch (error) {
        console.error("Failed to load book:", error);
      }
      setIsLoading(false);
    };

    loadBook();
  }, [articles, articleId]);

  // Cleanup object URL
  useEffect(() => {
    return () => {
      if (bookUrl) URL.revokeObjectURL(bookUrl);
    };
  }, [bookUrl]);

  // 处理加载超时（作为兜底方案）
  useEffect(() => {
    const timer = setTimeout(() => {
      // Only force stop loading if we are still loading and haven't found anything
      // But since we have async book loading, we should be careful not to cut it off too early.
      // 5 seconds should be enough for IDB.
    }, 5000); 
    return () => clearTimeout(timer);
  }, []);

  // 手势处理
  const onTouchStart = (e: React.TouchEvent) => {
    setTouchEnd(null);
    setTouchStart({
      x: e.targetTouches[0].clientX,
      y: e.targetTouches[0].clientY
    });
  };

  const onTouchMove = (e: React.TouchEvent) => {
    setTouchEnd({
      x: e.targetTouches[0].clientX,
      y: e.targetTouches[0].clientY
    });
  };

  const onTouchEnd = () => {
    if (!touchStart || !touchEnd) return;
    
    const xDistance = touchStart.x - touchEnd.x;
    const yDistance = touchStart.y - touchEnd.y;
    
    // 判断是否为右滑 (向右滑动，xDistance 为负)
    // 1. 距离必须足够长 (minSwipeDistance)
    // 2. 必须是水平滑动主导 (水平距离 > 垂直距离 * 1.5)
    const isRightSwipe = xDistance < -minSwipeDistance;
    const isHorizontal = Math.abs(xDistance) > Math.abs(yDistance) * 1.5;

    if (isRightSwipe && isHorizontal) {
      // 右滑返回
      router.back();
    }
  };

  const handleBack = () => {
    router.back();
  };

  return (
    <div 
      className="min-h-screen bg-white dark:bg-slate-900"
      onTouchStart={onTouchStart}
      onTouchMove={onTouchMove}
      onTouchEnd={onTouchEnd}
    >
        <main className={`mx-auto ${bookUrl ? 'w-full px-0 py-0' : 'max-w-4xl px-4 sm:px-6 lg:px-8 py-8'}`}>
          
          {isLoading ? (
            <div className="flex flex-col items-center justify-center py-20">
              <div className="w-8 h-8 border-4 border-primary-600 border-t-transparent rounded-full animate-spin mb-4"></div>
              <p className="text-slate-500 dark:text-slate-400">加载中...</p>
            </div>
          ) : article ? (
            <>
              {/* 顶部导航栏 - 始终显示 */}
              <div className="flex items-center justify-between mb-6">
                <button
                  onClick={handleBack}
                  className="inline-flex items-center gap-2 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 transition-colors"
                >
                  <ArrowLeft className="w-5 h-5" />
                  <span>返回</span>
                </button>
              </div>
              <ImmersiveReader 
                title={article.title}
                title_zh={article.title_zh}
                content={article.content} 
                phrases={article.phrases} 
                aiVocabulary={article.aiVocabulary} 
                tags={article.tags}
                wordCount={article.wordCount}
                createdAt={article.createdAt}
                difficulty={article.difficulty === "Beginner" ? "初级" : article.difficulty === "Intermediate" ? "中级" : "高级"}
              />
            </>
          ) : bookUrl ? (
            <div className="relative w-full h-[calc(100vh-64px)]">
               <div className="absolute top-4 left-4 z-50">
                <button
                  onClick={handleBack}
                  className="inline-flex items-center gap-2 px-3 py-1.5 bg-white/80 dark:bg-slate-800/80 backdrop-blur-sm rounded-full shadow-sm text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 transition-colors border border-slate-200 dark:border-slate-700"
                >
                  <ArrowLeft className="w-4 h-4" />
                  <span className="text-sm font-medium">返回</span>
                </button>
               </div>
               <EpubReader 
                 url={bookUrl} 
                 title={bookMetadata?.title} 
               />
            </div>
          ) : (
            <div className="text-center py-20">
              <p className="text-slate-500 dark:text-slate-400 mb-4">
                内容未找到 (ID: {articleId})
              </p>
              <p className="text-sm text-slate-400 mb-6">
                可能是内容已被删除或链接错误
              </p>
              <Link
                href="/library"
                className="text-primary-600 dark:text-primary-400 hover:underline"
              >
                前往书架
              </Link>
            </div>
          )}
        </main>
    </div>
  );
}
