export function lookupLocal(text: string) { 
  const key = normalizeKey(text); 
  const raw = RAW_DICT[key]; 
  
  if (raw) { 
    const [def, pho, tagCode, trans] = raw.split('|').map(s => s.trim()); 
    const tags = []; 
    if (tagCode === 'B') tags.push("基础"); 
    if (tagCode === 'A') tags.push("学术", "雅思"); 
    if (tagCode === 'C') tags.push("核心", "高频"); 

    return { 
      text: text, 
      definition: def, 
      phonetic: pho, 
      tags: tags, 
      example: "High-frequency word from local library.", 
      translation: trans || "（本地词库直出）", 
      source: "local" 
    }; 
  } 
  return null; 
}
