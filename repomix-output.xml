// --- 核心升级：适配新的等级系统 ---
const difficultyColors: Record<string, string> = {
  // 新等级配色
  'CET-4': "bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400",
  'CET-6': "bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400",
