                                placeholder="输入消息..."
                                className="w-full bg-slate-100 dark:bg-slate-900 text-slate-900 dark:text-slate-100 rounded-xl px-4 py-3 pr-12 resize-none focus:outline-none focus:ring-2 focus:ring-indigo-500/50"
                                rows={1}
