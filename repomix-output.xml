    if (!response.ok) throw new Error("API Error");
    
    const data = await response.json();
    return data.phrases || [];
  } catch (error) {
    console.error("AI Phrase Extraction Failed:", error);
    // Fallback: Return empty or simple heuristic
    return [];
  }
}

